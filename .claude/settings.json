{
  "hooks": {
    "PreToolUse": [
      {
        "_managed_by": "todo",
        "hooks": [
          {
            "command": "todo guard",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionEnd": [
      {
        "_managed_by": "todo",
        "hooks": [
          {
            "command": "todo session-end",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "_managed_by": "todo",
        "hooks": [
          {
            "command": "todo summary",
            "type": "command"
          }
        ]
      }
    ]
  }
}
