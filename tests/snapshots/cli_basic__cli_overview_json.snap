---
source: tests/cli_basic.rs
expression: ok_json
---
{
  "data": {
    "commands": [
      {
        "kind": "write",
        "name": "add",
        "summary": "Add a new task to a section"
      },
      {
        "kind": "write",
        "name": "answer",
        "summary": "Answer a question and mark it done"
      },
      {
        "kind": "write",
        "name": "ask",
        "summary": "Ask a question for a person to answer"
      },
      {
        "kind": "write",
        "name": "block",
        "summary": "Mark a task blocked with a reason"
      },
      {
        "kind": "write",
        "name": "claim",
        "summary": "Claim a task for an agent"
      },
      {
        "kind": "read",
        "name": "diff",
        "summary": "Show changes between snapshots or against the current TODO.md"
      },
      {
        "kind": "write",
        "name": "done",
        "summary": "Mark a task done"
      },
      {
        "kind": "write",
        "name": "drop",
        "summary": "Mark a task dropped with a reason"
      },
      {
        "kind": "meta",
        "name": "help",
        "summary": "Show overview or detailed help for a command"
      },
      {
        "kind": "read",
        "name": "history",
        "summary": "List saved snapshots of TODO.md"
      },
      {
        "kind": "read",
        "name": "list",
        "summary": "List and filter tasks"
      },
      {
        "kind": "write",
        "name": "lock",
        "summary": "Take a manual editing lease on TODO.md"
      },
      {
        "kind": "write",
        "name": "move",
        "summary": "Move a task to the end of another section"
      },
      {
        "kind": "read",
        "name": "next",
        "summary": "Pick the next ready task (optionally claiming it atomically)"
      },
      {
        "kind": "write",
        "name": "note",
        "summary": "Add a dated note to a task"
      },
      {
        "kind": "write",
        "name": "release",
        "summary": "Release a claimed task, all stale claims, or all claims of an agent"
      },
      {
        "kind": "write",
        "name": "reopen",
        "summary": "Put a done or dropped task back to open"
      },
      {
        "kind": "write",
        "name": "restore",
        "summary": "Restore TODO.md from a saved snapshot"
      },
      {
        "kind": "write",
        "name": "set",
        "summary": "Edit fields or title of a task"
      },
      {
        "kind": "read",
        "name": "show",
        "summary": "Show full details of a task"
      },
      {
        "kind": "read",
        "name": "status",
        "summary": "Show write lock and manual lease status"
      },
      {
        "kind": "write",
        "name": "unblock",
        "summary": "Unblock a blocked task back to claimed or open"
      },
      {
        "kind": "write",
        "name": "unlock",
        "summary": "End a manual editing lease on TODO.md"
      },
      {
        "kind": "read",
        "name": "where",
        "summary": "Show resolved TODO.md, repo root, state folder, lock status, and task counts"
      }
    ],
    "version": "0.1.0"
  },
  "ok": true,
  "schema": "todo.overview.v1",
  "warnings": []
}
