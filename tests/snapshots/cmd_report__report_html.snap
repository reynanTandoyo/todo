---
source: tests/cmd_report.rs
expression: html
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lantern tool — status</title>
<style>
/* The stylesheet of the v1.0 page (T-214; R-REPORT-1, R-REPORT-6; section 5.23). It is copied into
   the page inline, so it names no address and loads nothing. Light values are the defaults; the
   dark set applies when the system asks for it and the page has no mode chosen, or when the mode is
   set to dark. The colour-blind sets replace the state colours and the bar parts. */

:root{color-scheme:light dark}
body{margin:0}

.page{
  --p-bg:#ffffff; --p-fg:#171717; --p-mfg:#6b7280; --p-bd:#e4e4e7; --p-card:#ffffff; --p-mut:#f3f3f5;
  --c-done:#2f9e5f; --c-prog:#3b7fe0; --c-wait:#b07800; --c-todo:#80868e; --c-drop:#cf4a4a;
  --s-done:var(--c-done); --s-prog:var(--c-prog); --s-wait:var(--c-wait); --s-todo:var(--c-todo); --s-drop:var(--c-drop);
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
  background:var(--p-bg); color:var(--p-fg);
  max-width:820px; margin:0 auto; padding:20px 16px 32px; font-size:15px; line-height:1.45;
}
@media (prefers-color-scheme: dark){
  .page:not([data-theme]){
    --p-bg:#17181b; --p-fg:#e8e8ea; --p-mfg:#9a9ca3; --p-bd:#33353b; --p-card:#1d1f23; --p-mut:#26282d;
    --c-done:#4cc17f; --c-prog:#6aa5f5; --c-wait:#e0a526; --c-todo:#8b9098; --c-drop:#ee6b6b; color-scheme:dark;
  }
  .page:not([data-theme])[data-cb="on"]{
    --c-done:#56b4e9; --c-prog:#f0a830; --c-wait:#f0a830; --c-todo:#7d838c; --c-drop:#dcdfe3;
    --s-prog:#f0a830; --s-wait:repeating-linear-gradient(45deg,#f0a830 0 4px,#17181b 4px 8px); --s-todo:#4a4e55; --s-drop:#dcdfe3;
  }
}
.page[data-theme="light"]{ --p-bg:#ffffff; --p-fg:#171717; --p-mfg:#6b7280; --p-bd:#e4e4e7; --p-card:#ffffff; --p-mut:#f3f3f5; color-scheme:light }
.page[data-theme="dark"]{ --p-bg:#17181b; --p-fg:#e8e8ea; --p-mfg:#9a9ca3; --p-bd:#33353b; --p-card:#1d1f23; --p-mut:#26282d;
  --c-done:#4cc17f; --c-prog:#6aa5f5; --c-wait:#e0a526; --c-todo:#8b9098; --c-drop:#ee6b6b; color-scheme:dark }

.page *{box-sizing:border-box}
.page:not(.js) .controls{display:none}
.muted{color:var(--p-mfg)}
h1{font-size:22px; margin:0 0 2px}
h2{font-size:13px; text-transform:uppercase; letter-spacing:.06em; margin:28px 0 8px; color:var(--p-mfg); font-weight:600}
.page h3{font-size:14px; margin:16px 0 6px}
.head{display:flex; align-items:flex-start; gap:12px}
.head .grow{flex:1; min-width:0}
.head .controls{flex-direction:column; align-items:stretch; margin:0}
.desc{margin:0 0 2px}
.asof{margin:0; font-size:13px}

/* overall */
.overall{margin:18px 0 0}
.overall .big{font-size:17px; font-weight:600; margin:0 0 6px}
.seg{display:flex; height:10px; border-radius:5px; overflow:hidden; background:var(--p-mut)}
.seg i{display:block; height:100%}
.seg-done{background:var(--s-done)}
.seg-prog{background:var(--s-prog)}
.seg-wait{background:var(--s-wait)}
.seg-todo{background:var(--s-todo)}
.seg-drop{background:var(--s-drop)}
.legend{display:flex; flex-wrap:wrap; gap:4px 16px; margin:8px 0 0; padding:0; list-style:none; font-size:13px}
.legend b{font-weight:600}

/* marks */
.mark{display:inline-block; width:1.3em; text-align:center; font-weight:700; flex:none}
.done .mark,.mark.done{color:var(--c-done)} .prog .mark,.mark.prog{color:var(--c-prog)}
.wait .mark,.mark.wait{color:var(--c-wait)} .todo .mark,.mark.todo{color:var(--c-todo)}
.drop .mark,.mark.drop{color:var(--c-drop)}

/* needs you */
.box{border:1px solid var(--p-bd); border-radius:8px; padding:4px 14px; background:var(--p-card)}
.box.attn{border-left:4px solid var(--c-wait)}
.need{padding:10px 0; border-top:1px solid var(--p-bd)}
.need:first-child{border-top:0}
.need .what{font-weight:600}
.need p{margin:2px 0 0}
.tag{font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:.04em; color:var(--c-wait); margin-right:6px}

/* recent */
.recent{list-style:none; margin:0; padding:0}
.recent li{display:flex; gap:10px; padding:3px 0}
.recent .d{width:52px; flex:none; font-size:13px; color:var(--p-mfg); padding-top:1px}

/* controls */
.controls{display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin:0 0 10px}
.controls .sp{flex:1}
.controls button{font:inherit; font-size:13px; padding:4px 10px; border-radius:6px; cursor:pointer;
  border:1px solid var(--p-bd); background:var(--p-bg); color:var(--p-fg)}
.controls button:hover{background:var(--p-mut); color:var(--p-fg)}
.controls button[aria-pressed="true"]{background:var(--p-fg); color:var(--p-bg); border-color:var(--p-fg)}
.controls span{font-size:13px}

/* tree */
details.ms{border:1px solid var(--p-bd); border-radius:8px; margin:0 0 10px; background:var(--p-card)}
details.ms details.ms{border:0; border-left:2px solid var(--p-bd); border-radius:0; margin:6px 0 6px 6px; background:none}
details.ms>summary{display:flex; align-items:center; gap:10px; padding:10px 12px; cursor:pointer; list-style:none}
details.ms details.ms>summary{padding:6px 10px}
details.ms>summary::-webkit-details-marker{display:none}
details.ms>summary::before{content:"\25B8"; width:1em; flex:none; color:var(--p-mfg)}
details.ms[open]>summary::before{content:"\25BE"}
.ms-title{font-weight:600; flex:1; min-width:0}
details.ms details.ms .ms-title{font-weight:600; font-size:14px}
.ms-state{font-size:12px; font-weight:600; flex:none}
.ms-count{font-size:13px; flex:none; color:var(--p-mfg); white-space:nowrap}
.bar{width:90px; height:6px; border-radius:3px; background:var(--p-mut); overflow:hidden; flex:none}
.bar i{display:block; height:100%; background:var(--c-done)}
.ms-body{padding:0 12px 10px 34px}
details.ms details.ms .ms-body{padding:0 4px 4px 30px}
.goal{margin:0 0 8px; font-size:14px; color:var(--p-mfg)}
ul.items{list-style:none; margin:0; padding:0}
li.item{padding:3px 0}
li.item>details>summary{display:flex; align-items:baseline; gap:6px; cursor:pointer; list-style:none; border-radius:4px; padding:1px 2px}
li.item>details>summary::-webkit-details-marker{display:none}
li.item>details>summary:hover{background:var(--p-mut)}
.t{flex:1; min-width:0}
li.done .t{color:var(--p-mfg)}
li.drop .t{color:var(--p-mfg); text-decoration:line-through}
.when,.id{font-size:12px; color:var(--p-mfg); flex:none; white-space:nowrap}
.id{font-family:ui-monospace,Consolas,monospace; opacity:.75}
.line2{margin:0 0 2px 1.75em; font-size:13px; color:var(--p-mfg)}
.line2 b{font-weight:600; color:var(--p-fg)}
.more{margin:4px 0 8px 1.75em; padding:8px 12px; border-left:2px solid var(--p-bd); background:var(--p-mut); border-radius:0 6px 6px 0; font-size:14px}
.more p{margin:0 0 6px}
.more .lbl{font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:.04em; color:var(--p-mfg)}
details.tech>summary{cursor:pointer; font-size:13px; color:var(--p-mfg)}
details.tech dl{display:grid; grid-template-columns:max-content 1fr; gap:2px 12px; margin:6px 0 0; font-size:13px}
details.tech dt{color:var(--p-mfg)} details.tech dd{margin:0; overflow-wrap:anywhere}
.st-prog{color:var(--c-prog)}
.st-none{color:var(--p-mfg)}
.st-done{color:var(--c-done)}
.st-drop{color:var(--c-drop)}
.stale{color:var(--c-wait)}

/* more */
details.fold{border-top:1px solid var(--p-bd); padding:8px 0}
details.fold>summary{cursor:pointer; font-weight:600}
details.fold>summary .muted{font-weight:400}
details.fold p,details.fold ul{font-size:14px; margin:6px 0 0}
.hint,.empty{color:var(--p-mfg); font-size:14px; margin:6px 0 0}
.areas{list-style:none; margin:6px 0 0; padding:0}
.areas li{display:flex; justify-content:space-between; gap:1rem; padding:4px 0; border-bottom:1px solid var(--p-bd)}
.areas .count{font-weight:600; font-variant-numeric:tabular-nums}
.card-list{list-style:none; margin:6px 0 0; padding:0}
.card-list li{padding:4px 0}
.chip{display:inline-block; margin:0 4px 0 0; padding:0 8px; border-radius:999px; background:var(--p-mut); font-size:13px; line-height:1.6; white-space:nowrap}
.reason{color:var(--c-wait)}
.hide{display:none !important}

.page h4{font-size:13px; margin:12px 0 4px}
.page code{font-family:ui-monospace,Consolas,monospace; font-size:.92em; background:var(--p-mut); padding:0 3px; border-radius:3px}
.ms-mark{display:inline-block; flex:none; min-width:1.5em; padding:0 4px; border:1.5px solid var(--p-fg); border-radius:4px; font-size:11px; font-weight:700; line-height:1.5; text-align:center}
.ms-id{flex:none; font-size:12px; color:var(--p-mfg); font-family:ui-monospace,Consolas,monospace}
details.chain{margin-top:6px}
details.chain>summary{cursor:pointer; font-size:13px; color:var(--p-mfg)}
.chain-line{margin:2px 0 6px; font-size:13px; line-height:1.6}
.chain-line .cid{font-family:ui-monospace,Consolas,monospace; font-size:12px}
.sr{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap}
.arch-label{margin:14px 0 8px; font-size:13px; font-weight:600; color:var(--p-mfg)}

@media (max-width:560px){ .bar{display:none} .id{display:none} .ms-id{display:none} }
@media print{ .controls{display:none} details.ms{break-inside:avoid} .sr{position:static; width:auto; height:auto; clip:auto} }

/* colour-blind mode (red/green): only blue, orange, greys and a stripe pattern; one set per background */
.page[data-cb="on"]{
  --c-done:#0072b2; --c-prog:#a86400; --c-wait:#a86400; --c-todo:#8e949c; --c-drop:#33363b;
  --s-prog:#e69f00; --s-wait:repeating-linear-gradient(45deg,#e69f00 0 4px,#1f1f1f 4px 8px); --s-todo:#c9ccd1; --s-drop:#33363b;
}
.page[data-theme="dark"][data-cb="on"]{
  --c-done:#56b4e9; --c-prog:#f0a830; --c-wait:#f0a830; --c-todo:#7d838c; --c-drop:#dcdfe3;
  --s-prog:#f0a830; --s-wait:repeating-linear-gradient(45deg,#f0a830 0 4px,#17181b 4px 8px); --s-todo:#4a4e55; --s-drop:#dcdfe3;
}
.page[data-cb="on"] .seg{height:12px}
.page[data-cb="on"] li.wait .line2 b, .page[data-cb="on"] li.drop .line2 b{text-decoration:underline}
</style>
</head>
<body>
<div class="page">
<header class="head"><div class="grow">
<h1>Lantern tool</h1>
<p class="desc">Plans the lanterns for the club hall from a sky map.</p>
<p class="asof muted">Status as of 19 Nov 2026, 10:00 · from TODO.md</p>
</div>
<div class="controls">
<button id="theme" type="button">Dark mode</button>
<button id="cb" type="button" aria-pressed="false" title="Colours that stay apart with red-green colour blindness">Colour-blind colours</button>
</div>
</header>
<div class="overall">
<p class="big">5 of 12 tasks done</p>
<div class="seg" role="img" aria-label="5 done, 2 in progress, 3 waiting, 2 to do, 2 cancelled">
<i class="seg-done" style="width:35.7%"></i><i class="seg-prog" style="width:14.3%"></i><i class="seg-wait" style="width:21.4%"></i><i class="seg-todo" style="width:14.3%"></i><i class="seg-drop" style="width:14.3%"></i></div>
<ul class="legend">
<li><span class="mark done">✓</span><b>5</b> done</li>
<li><span class="mark prog">●</span><b>2</b> in progress</li>
<li><span class="mark wait">◐</span><b>3</b> waiting</li>
<li><span class="mark todo">○</span><b>2</b> to do</li>
<li><span class="mark drop">✕</span><b>2</b> cancelled <span class="muted">(not counted in the 12)</span></li>
</ul>
</div>
<h2>Needs you (3)</h2>
<div class="box attn">
<div class="need"><span class="tag">Question</span><span class="what">How many lanterns per room?</span>
<p class="muted">Asked 15 Nov · about “Lamp plan” · the task “Count the lanterns per room” waits for this answer</p></div>
<div class="need"><span class="tag">Given back</span><span class="what">Place the lanterns on the east wall</span>
<p class="muted">A worker could not finish it (16 Nov): the plan puts one lantern too many on the east wall</p></div>
<div class="need"><span class="tag">No activity</span><span class="what">Write the sky map test set</span>
<p class="muted">In progress for 14 days by sam. It may have been abandoned.</p></div>
</div>
<h2>Last 7 days</h2>
<ul class="recent">
<li><span class="d">18 Nov</span><span class="mark done">✓</span><span><b>Club hall</b> finished — all 2 tasks done</span></li>
<li><span class="d">18 Nov</span><span class="mark done">✓</span><span>Mark the ceiling points</span></li>
<li><span class="d">17 Nov</span><span class="mark done">✓</span><span>The star catalogue is read from its text file, with the position and brightness of each star.</span></li>
<li><span class="d">17 Nov</span><span class="mark done">✓</span><span>The hall is measured wall to wall, with the height of the ceiling.</span></li>
<li><span class="d">17 Nov</span><span class="mark todo">＋</span><span>Added: The hall is measured wall to wall, with the height of the ceiling.</span></li>
<li><span class="d">16 Nov</span><span class="mark done">✓</span><span>Pick the font for the plan</span></li>
<li><span class="d">16 Nov</span><span class="mark todo">＋</span><span>2 tasks added to <b>Sky map reader</b></span></li>
<li><span class="d">15 Nov</span><span class="mark done">✓</span><span>Agree the lamp colour</span></li>
<li><span class="d">15 Nov</span><span class="mark todo">＋</span><span>Added: Count the lanterns per room</span></li>
<li><span class="d">14 Nov</span><span class="mark drop">✕</span><span>Print a poster <span class="muted">— cancelled: the plan on the screen is enough</span></span></li>
<li><span class="d">13 Nov</span><span class="mark todo">＋</span><span>Added: The star catalogue is read from its text file, with the position and brightness of each star.</span></li>
</ul>
<h2>All work</h2>
<div class="controls">
<span class="muted">Show</span>
<button data-f="all" aria-pressed="true">Everything</button>
<button data-f="left" aria-pressed="false">Still to do</button>
<button data-f="done" aria-pressed="false">Done</button>
<button data-f="drop" aria-pressed="false">Cancelled</button>
<span class="sp"></span>
<button id="exp" type="button">Expand all</button>
<button id="col" type="button">Collapse all</button>
</div>
<div id="tree">
<details class="ms" open>
<summary><span class="ms-title">Lantern tool</span><span class="ms-state st-prog">in progress</span><span class="ms-count">4 of 10 done</span><span class="bar"><i style="width:40%"></i></span></summary>
<div class="ms-body">
<p class="goal">Goal: a sky map becomes the list of lanterns for the club hall</p>
<div class="more"><p><span class="lbl">Summary</span><br>Turns a sky map into the lanterns to hang in the club hall.</p></div>
<details class="ms" open>
<summary><span class="ms-title">Sky map reader</span><span class="ms-state st-prog">in progress</span><span class="ms-count">1 of 4 done</span><span class="bar"><i style="width:25%"></i></span></summary>
<div class="ms-body">
<p class="goal">Goal: every map format the club uses can be read</p>
<ul class="items">
<li class="item done"><details><summary><span class="mark">✓</span><span class="t">Read the star catalogue</span><span class="when">17 Nov</span><span class="id">T-003</span></summary><div class="more"><p><span class="lbl">Summary</span><br>The star catalogue is read from its text file, with the position and brightness of each star.</p><p><span class="lbl">Result</span><br>the reader also takes the old file layout</p><details class="tech"><summary>Technical details</summary><dl><dt>Level</dt><dd>2</dd><dt>Priority</dt><dd>P1</dd><dt>Area</dt><dd>parser</dd><dt>Notes</dt><dd><ul><li><span class="when">13 Nov</span> · ines · added</li><li><span class="when">17 Nov</span> · ines · done — the reader also takes the old file layout</li></ul></dd></dl></details></div></details></li>
<li class="item prog"><details><summary><span class="mark">●</span><span class="t">Parse the map header</span><span class="id">T-004</span></summary><div class="more"><p><span class="lbl">Why</span><br>the header says which map format a file uses</p><details class="tech"><summary>Technical details</summary><dl><dt>Level</dt><dd>2</dd><dt>Priority</dt><dd>P1</dd><dt>Area</dt><dd>parser</dd><dt>Done by</dt><dd>ines</dd><dt>Notes</dt><dd><ul><li><span class="when">16 Nov</span> · ines · added</li></ul></dd></dl></details></div></details>
<p class="line2"><b>In progress</b> · ines · since yesterday</p></li>
<li class="item todo"><details><summary><span class="mark">○</span><span class="t">Read the grid format</span><span class="id">T-005</span></summary><div class="more"><p><span class="lbl">Why</span><br>the club&#39;s older maps use a grid, not a list of stars</p><details class="tech"><summary>Technical details</summary><dl><dt>Level</dt><dd>3</dd><dt>Priority</dt><dd>P2</dd><dt>Area</dt><dd>parser</dd><dt>Depends</dt><dd>T-004 Parse the map header</dd><dt>Notes</dt><dd><ul><li><span class="when">16 Nov</span> · ines · added</li></ul></dd></dl></details></div></details></li>
<li class="item prog"><details><summary><span class="mark">●</span><span class="t">Write the sky map test set</span><span class="id">T-006</span></summary><div class="more"><p><span class="lbl">Summary</span><br>A small set of maps with known answers, checked on every change.</p><details class="tech"><summary>Technical details</summary><dl><dt>Level</dt><dd>2</dd><dt>Priority</dt><dd>P2</dd><dt>Area</dt><dd>tests</dd><dt>Done by</dt><dd>sam</dd></dl></details></div></details>
<p class="line2"><b>In progress</b> · sam · for 14 days · <span class="stale">no activity</span></p></li>
<li class="item drop"><details><summary><span class="mark">✕</span><span class="t">Convert the old map format</span><span class="when">10 Nov</span><span class="id">T-010</span></summary><div class="more"><details class="tech"><summary>Technical details</summary><dl><dt>Level</dt><dd>3</dd><dt>Priority</dt><dd>P3</dd><dt>Area</dt><dd>parser</dd><dt>Notes</dt><dd><ul><li><span class="when">10 Nov</span> · sam · dropped — the club has no maps left in that format</li></ul></dd></dl></details></div></details>
<p class="line2"><b>Cancelled</b> · the club has no maps left in that format</p></li>
</ul>
</div>
</details>
<details class="ms" open>
<summary><span class="ms-title">Lamp plan</span><span class="ms-state st-prog">in progress</span><span class="ms-count">0 of 3 done</span><span class="bar"><i style="width:0%"></i></span></summary>
<div class="ms-body">
<p class="goal">Goal: each room has a plan of its lanterns</p>
<ul class="items">
<li class="item wait"><details><summary><span class="mark">◐</span><span class="t">Print the lantern plan</span><span class="id">T-012</span></summary><div class="more"><details class="tech"><summary>Technical details</summary><dl><dt>Level</dt><dd>3</dd><dt>Priority</dt><dd>P2</dd><dt>Area</dt><dd>output</dd><dt>Notes</dt><dd><ul><li><span class="when">15 Nov</span> · sam · blocked — waiting for the printer driver</li></ul></dd></dl></details></div></details>
<p class="line2"><b>Waiting</b> · waiting for the printer driver</p></li>
<li class="item wait"><details><summary><span class="mark">◐</span><span class="t">Place the lanterns on the east wall</span><span class="id">T-013</span></summary><div class="more"><details class="tech"><summary>Technical details</summary><dl><dt>Level</dt><dd>4</dd><dt>Priority</dt><dd>P1</dd><dt>Area</dt><dd>plan</dd><dt>Notes</dt><dd><ul><li><span class="when">16 Nov</span> · sam · stuck — the plan puts one lantern too many on the east wall</li></ul></dd></dl></details></div></details>
<p class="line2"><b>Waiting</b> · given back by a worker: the plan puts one lantern too many on the east wall</p></li>
<li class="item wait"><details><summary><span class="mark">◐</span><span class="t">Count the lanterns per room</span><span class="id">T-014</span></summary><div class="more"><details class="tech"><summary>Technical details</summary><dl><dt>Level</dt><dd>3</dd><dt>Priority</dt><dd>P1</dd><dt>Area</dt><dd>plan</dd><dt>Depends</dt><dd>T-015 How many lanterns per room?</dd><dt>Notes</dt><dd><ul><li><span class="when">15 Nov</span> · sam · added</li></ul></dd></dl></details></div></details>
<p class="line2"><b>Waiting</b> · for your answer: How many lanterns per room?</p></li>
</ul>
</div>
</details>
<details class="ms">
<summary><span class="ms-title">Club hall</span><span class="ms-state st-done">finished 18 Nov</span><span class="ms-count">2 of 2 done</span><span class="bar"><i style="width:100%"></i></span></summary>
<div class="ms-body">
<p class="goal">Goal: the hall is measured and marked before the plan is drawn</p>
